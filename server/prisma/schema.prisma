generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// =====================================================
// USER & GITHUB AUTHENTICATION
// =====================================================

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  repositories Repository[]
  projects     Project[]
  tasks        Task[]
}


// =====================================================
// GITHUB ACCOUNT
// =====================================================

model Account {
  id                String   @id @default(cuid())

  provider          String
  providerAccountId String

  // GitHub authorization credentials
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}


// =====================================================
// GITHUB REPOSITORY
// =====================================================

model Repository {
  id            String   @id @default(cuid())

  // GitHub repository information
  githubId      String   @unique
  name          String
  fullName      String
  url           String
  defaultBranch String   @default("main")
  language      String?
  stars         Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Repository owner
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks         Task[]
  pullRequests  PullRequest[]

  @@index([userId])
}


// =====================================================
// PROJECT
// =====================================================

model Project {
  id          String   @id @default(cuid())

  name        String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks       Task[]

  @@index([userId])
}


// =====================================================
// TASK
// =====================================================

model Task {
  id           String       @id @default(cuid())

  title        String
  description  String?

  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // User who created the task
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Syntnex project
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // GitHub repository being modified
  repositoryId String
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  agentRuns    AgentRun[]
  pullRequests PullRequest[]

  @@index([userId])
  @@index([projectId])
  @@index([repositoryId])
}


// =====================================================
// AI AGENT RUN
// =====================================================

model AgentRun {
  id          String         @id @default(cuid())

  status      AgentRunStatus @default(PENDING)

  // Current agent execution information
  branchName  String?
  currentStep String?
  progress    Int            @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  error       String?

  createdAt   DateTime       @default(now())

  taskId      String
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  steps       AgentStep[]
  fileChanges FileChange[]
  testRuns    TestRun[]

  @@index([taskId])
}


// =====================================================
// AI AGENT STEP
// =====================================================

model AgentStep {
  id          String         @id @default(cuid())

  stepNumber  Int
  type        AgentStepType
  status      StepStatus     @default(PENDING)

  description String?

  // Agent input/output
  input       Json?
  output      Json?
  error       String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt   DateTime       @default(now())

  agentRunId  String
  agentRun    AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, stepNumber])
  @@index([agentRunId])
}


// =====================================================
// FILE CHANGES
// =====================================================

model FileChange {
  id          String     @id @default(cuid())

  filePath    String
  changeType  ChangeType

  additions   Int        @default(0)
  deletions   Int        @default(0)

  // Git diff generated by the AI agent
  diff        String?

  createdAt   DateTime   @default(now())

  agentRunId  String
  agentRun    AgentRun   @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
}


// =====================================================
// TEST RUN
// =====================================================

model TestRun {
  id          String         @id @default(cuid())

  status      TestRunStatus

  command     String?
  output      String?
  error       String?

  totalTests  Int            @default(0)
  passedTests Int            @default(0)
  failedTests Int            @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt   DateTime       @default(now())

  agentRunId  String
  agentRun    AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
}


// =====================================================
// PULL REQUEST
// =====================================================

model PullRequest {
  id           String     @id @default(cuid())

  // GitHub PR information
  githubId     String     @unique
  number       Int
  title        String
  url          String
  branchName   String

  status       PRStatus   @default(OPEN)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  taskId       String
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([taskId])
  @@index([repositoryId])
}


// =====================================================
// ENUMS
// =====================================================

enum TaskStatus {
  PENDING
  PLANNING
  IN_PROGRESS
  TESTING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentStepType {
  ANALYZE
  PLAN
  READ_FILE
  WRITE_FILE
  EDIT_FILE
  RUN_TEST
  FIX_ERROR
  CREATE_BRANCH
  CREATE_PR
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ChangeType {
  CREATED
  MODIFIED
  DELETED
}

enum TestRunStatus {
  RUNNING
  PASSED
  FAILED
}

enum PRStatus {
  OPEN
  MERGED
  CLOSED
}